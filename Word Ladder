import java.util.*;

class Solution {

    public int ladderLength(
            String beginWord,
            String endWord,
            List<String> wordList) {

        Set<String> wordSet = new HashSet<>(wordList);

        // If endWord doesn't exist,
        // transformation is impossible.
        if (!wordSet.contains(endWord)) {
            return 0;
        }

        Queue<String> queue = new LinkedList<>();

        queue.offer(beginWord);

        int level = 1;

        while (!queue.isEmpty()) {

            int size = queue.size();

            // Process one BFS level
            for (int i = 0; i < size; i++) {

                String current = queue.poll();

                char[] word = current.toCharArray();

                // Change every character
                for (int position = 0;
                     position < word.length;
                     position++) {

                    char original = word[position];

                    // Try all 26 letters
                    for (char ch = 'a'; ch <= 'z'; ch++) {

                        if (ch == original) {
                            continue;
                        }

                        word[position] = ch;

                        String nextWord = new String(word);

                        // Found the target
                        if (nextWord.equals(endWord)) {
                            return level + 1;
                        }

                        // Valid and not visited
                        if (wordSet.contains(nextWord)) {

                            queue.offer(nextWord);

                            // Mark visited
                            wordSet.remove(nextWord);
                        }
                    }

                    // Restore original character
                    word[position] = original;
                }
            }

            level++;
        }

        return 0;
    }
}
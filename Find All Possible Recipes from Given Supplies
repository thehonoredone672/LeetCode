import java.util.*;

class Solution {
    public List<String> findAllRecipes(
        String[] recipes,
        List<List<String>> ingredients,
        String[] supplies
    ) {
        Map<String, List<String>> graph = new HashMap<>();
        Map<String, Integer> indegree = new HashMap<>();

        for (int i = 0; i < recipes.length; i++) {
            String recipe = recipes[i];

            indegree.put(recipe, ingredients.get(i).size());

            for (String ingredient : ingredients.get(i)) {
                graph.computeIfAbsent(
                    ingredient, key -> new ArrayList<>()
                ).add(recipe);
            }
        }

        Queue<String> queue = new LinkedList<>();

        for (String supply : supplies) {
            queue.offer(supply);
        }

        List<String> result = new ArrayList<>();

        while (!queue.isEmpty()) {
            String item = queue.poll();

            if (indegree.containsKey(item) &&
                indegree.get(item) == 0) {
                result.add(item);
            }

            for (String recipe :
                 graph.getOrDefault(item, Collections.emptyList())) {

                int remaining = indegree.get(recipe) - 1;
                indegree.put(recipe, remaining);

                if (remaining == 0) {
                    queue.offer(recipe);
                }
            }
        }

        return result;
    }
}

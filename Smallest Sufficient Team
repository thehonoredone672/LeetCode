import java.util.*;

class Solution {
    public int[] smallestSufficientTeam(
        String[] req_skills,
        List<List<String>> people
    ) {
        int m = req_skills.length;
        int n = people.size();

        // Map each skill to a bit position
        Map<String, Integer> skillMap = new HashMap<>();

        for (int i = 0; i < m; i++) {
            skillMap.put(req_skills[i], i);
        }

        // Convert each person's skills into a bitmask
        int[] personMask = new int[n];

        for (int i = 0; i < n; i++) {
            for (String skill : people.get(i)) {
                int bit = skillMap.get(skill);
                personMask[i] |= (1 << bit);
            }
        }

        int target = (1 << m) - 1;

        // dp[mask] = smallest team covering this skill mask
        List<Integer>[] dp = new ArrayList[1 << m];

        dp[0] = new ArrayList<>();

        // Process each person
        for (int i = 0; i < n; i++) {

            for (int mask = 0; mask <= target; mask++) {

                if (dp[mask] == null) {
                    continue;
                }

                int newMask = mask | personMask[i];

                if (newMask == mask) {
                    continue;
                }

                List<Integer> candidate =
                    new ArrayList<>(dp[mask]);

                candidate.add(i);

                if (dp[newMask] == null ||
                    candidate.size() < dp[newMask].size()) {

                    dp[newMask] = candidate;
                }
            }
        }

        // Convert the selected team into an array
        List<Integer> answer = dp[target];

        int[] result = new int[answer.size()];

        for (int i = 0; i < answer.size(); i++) {
            result[i] = answer.get(i);
        }

        return result;
    }
}

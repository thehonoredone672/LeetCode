import java.util.*;

class Solution {
    public int minReorder(int n, int[][] connections) {
        List<int[]>[] graph = new ArrayList[n];

        for (int i = 0; i < n; i++) {
            graph[i] = new ArrayList<>();
        }

        for (int[] edge : connections) {
            int u = edge[0];
            int v = edge[1];

            graph[u].add(new int[]{v, 1});
            graph[v].add(new int[]{u, 0});
        }

        boolean[] visited = new boolean[n];
        Queue<Integer> queue = new LinkedList<>();

        queue.offer(0);
        visited[0] = true;

        int changes = 0;

        while (!queue.isEmpty()) {
            int node = queue.poll();

            for (int[] edge : graph[node]) {
                int next = edge[0];
                int cost = edge[1];

                if (!visited[next]) {
                    visited[next] = true;
                    changes += cost;
                    queue.offer(next);
                }
            }
        }

        return changes;
    }
}

class Solution {

    public ListNode reverseKGroup(ListNode head, int k) {

        ListNode node = head;

        // Check if k nodes exist
        for (int i = 0; i < k; i++) {

            if (node == null) {
                return head;
            }

            node = node.next;
        }

        // Reverse k nodes
        ListNode prev = null;
        ListNode curr = head;

        for (int i = 0; i < k; i++) {

            ListNode next = curr.next;

            curr.next = prev;

            prev = curr;
            curr = next;
        }

        // Connect remaining list
        head.next = reverseKGroup(curr, k);

        return prev;
    }
}
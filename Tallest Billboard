import java.util.HashMap;
import java.util.Map;

class Solution {
    public int tallestBillboard(int[] rods) {
        Map<Integer, Integer> dp = new HashMap<>();

        dp.put(0, 0);

        for (int rod : rods) {
            Map<Integer, Integer> next = new HashMap<>(dp);

            for (Map.Entry<Integer, Integer> entry : dp.entrySet()) {
                int diff = entry.getKey();
                int shorter = entry.getValue();

                // Add rod to the taller support
                int newDiff = diff + rod;
                next.put(
                    newDiff,
                    Math.max(next.getOrDefault(newDiff, 0), shorter)
                );

                // Add rod to the shorter support
                newDiff = Math.abs(diff - rod);
                int newShorter = shorter + Math.min(diff, rod);

                next.put(
                    newDiff,
                    Math.max(next.getOrDefault(newDiff, 0), newShorter)
                );
            }

            dp = next;
        }

        return dp.get(0);
    }
}

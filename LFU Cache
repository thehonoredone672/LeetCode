import java.util.*;

class LFUCache {

    private static class Node {
        int key;
        int value;
        int frequency;
        Node prev;
        Node next;

        Node(int key, int value) {
            this.key = key;
            this.value = value;
            this.frequency = 1;
        }
    }

    private static class DoublyLinkedList {
        Node head;
        Node tail;
        int size;

        DoublyLinkedList() {
            head = new Node(0, 0);
            tail = new Node(0, 0);

            head.next = tail;
            tail.prev = head;
        }

        // Insert as most recently used
        void addFirst(Node node) {
            node.next = head.next;
            node.prev = head;

            head.next.prev = node;
            head.next = node;

            size++;
        }

        void remove(Node node) {
            node.prev.next = node.next;
            node.next.prev = node.prev;
            size--;
        }

        // Remove least recently used
        Node removeLast() {
            if (size == 0) {
                return null;
            }

            Node node = tail.prev;
            remove(node);
            return node;
        }

        boolean isEmpty() {
            return size == 0;
        }
    }

    private final int capacity;
    private int minFrequency;

    private final Map<Integer, Node> keyToNode;
    private final Map<Integer, DoublyLinkedList> frequencyToList;

    public LFUCache(int capacity) {
        this.capacity = capacity;
        this.minFrequency = 0;

        keyToNode = new HashMap<>();
        frequencyToList = new HashMap<>();
    }

    public int get(int key) {
        Node node = keyToNode.get(key);

        if (node == null) {
            return -1;
        }

        increaseFrequency(node);
        return node.value;
    }

    public void put(int key, int value) {
        if (capacity == 0) {
            return;
        }

        // Update existing key
        if (keyToNode.containsKey(key)) {
            Node node = keyToNode.get(key);
            node.value = value;

            increaseFrequency(node);
            return;
        }

        // Evict if cache is full
        if (keyToNode.size() >= capacity) {
            DoublyLinkedList minList =
                frequencyToList.get(minFrequency);

            Node evicted = minList.removeLast();
            keyToNode.remove(evicted.key);

            if (minList.isEmpty()) {
                frequencyToList.remove(minFrequency);
            }
        }

        // New nodes start with frequency 1
        Node node = new Node(key, value);
        keyToNode.put(key, node);

        frequencyToList
            .computeIfAbsent(
                1,
                f -> new DoublyLinkedList()
            )
            .addFirst(node);

        minFrequency = 1;
    }

    private void increaseFrequency(Node node) {
        int oldFrequency = node.frequency;

        DoublyLinkedList oldList =
            frequencyToList.get(oldFrequency);

        oldList.remove(node);

        if (oldList.isEmpty()) {
            frequencyToList.remove(oldFrequency);

            if (minFrequency == oldFrequency) {
                minFrequency++;
            }
        }

        node.frequency++;

        frequencyToList
            .computeIfAbsent(
                node.frequency,
                f -> new DoublyLinkedList()
            )
            .addFirst(node);
    }
}
import java.util.*;

class Solution {
    public int jobScheduling(
        int[] startTime,
        int[] endTime,
        int[] profit
    ) {
        int n = startTime.length;

        // Each job: [start, end, profit]
        int[][] jobs = new int[n][3];

        for (int i = 0; i < n; i++) {
            jobs[i][0] = startTime[i];
            jobs[i][1] = endTime[i];
            jobs[i][2] = profit[i];
        }

        // Sort jobs by ending time
        Arrays.sort(jobs, (a, b) ->
            Integer.compare(a[1], b[1])
        );

        // dp[i] = maximum profit using the first i jobs
        int[] dp = new int[n + 1];

        // Store all sorted end times for binary search
        int[] ends = new int[n];

        for (int i = 0; i < n; i++) {
            ends[i] = jobs[i][1];
        }

        for (int i = 1; i <= n; i++) {
            int start = jobs[i - 1][0];
            int currentProfit = jobs[i - 1][2];

            // Number of earlier jobs ending <= current start
            int compatible = upperBound(ends, i - 1, start);

            // Option 1: Skip this job
            int skip = dp[i - 1];

            // Option 2: Take this job
            int take = currentProfit + dp[compatible];

            dp[i] = Math.max(skip, take);
        }

        return dp[n];
    }

    // Returns the number of values <= target
    // within ends[0 ... length - 1].
    private int upperBound(int[] ends, int length, int target) {
        int left = 0;
        int right = length;

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (ends[mid] <= target) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }

        return left;
    }
}
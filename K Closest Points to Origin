import java.util.*;

class Solution {
    public int[][] kClosest(int[][] points, int k) {

        // Max heap based on squared distance
        PriorityQueue<int[]> pq = new PriorityQueue<>(
            (a, b) -> Long.compare(
                distance(b), distance(a)
            )
        );

        for (int[] point : points) {

            pq.offer(point);

            // Keep only k closest points
            if (pq.size() > k) {
                pq.poll();
            }
        }

        int[][] result = new int[k][2];

        for (int i = 0; i < k; i++) {
            result[i] = pq.poll();
        }

        return result;
    }

    private long distance(int[] point) {
        long x = point[0];
        long y = point[1];

        return x * x + y * y;
    }
}

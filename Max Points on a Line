import java.util.*;

class Solution {
    public int maxPoints(int[][] points) {
        int n = points.length;

        if (n <= 2) {
            return n;
        }

        int answer = 0;

        for (int i = 0; i < n; i++) {
            Map<String, Integer> slopeCount = new HashMap<>();

            int duplicates = 0;
            int maxForAnchor = 0;

            for (int j = i + 1; j < n; j++) {
                int dx = points[j][0] - points[i][0];
                int dy = points[j][1] - points[i][1];

                // Duplicate point
                if (dx == 0 && dy == 0) {
                    duplicates++;
                    continue;
                }

                // Vertical line
                if (dx == 0) {
                    dy = 1;
                    dx = 0;
                }
                // Horizontal line
                else if (dy == 0) {
                    dx = 1;
                }
                // Reduce slope and normalize its sign
                else {
                    int gcd = gcd(Math.abs(dx), Math.abs(dy));

                    dx /= gcd;
                    dy /= gcd;

                    if (dx < 0) {
                        dx = -dx;
                        dy = -dy;
                    }
                }

                String slope = dy + "/" + dx;

                int count = slopeCount.getOrDefault(slope, 0) + 1;
                slopeCount.put(slope, count);

                maxForAnchor = Math.max(maxForAnchor, count);
            }

            answer = Math.max(
                answer,
                maxForAnchor + duplicates + 1
            );
        }

        return answer;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int remainder = a % b;
            a = b;
            b = remainder;
        }

        return a;
    }
}
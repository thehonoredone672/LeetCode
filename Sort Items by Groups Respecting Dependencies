import java.util.*;

class Solution {
    public int[] sortItems(
        int n,
        int m,
        int[] group,
        List<List<Integer>> beforeItems
    ) {
        int groups = m;

        // Assign a unique group to every ungrouped item
        for (int i = 0; i < n; i++) {
            if (group[i] == -1) {
                group[i] = groups++;
            }
        }

        List<Integer>[] itemGraph = new ArrayList[n];
        List<Integer>[] groupGraph = new ArrayList[groups];

        for (int i = 0; i < n; i++) {
            itemGraph[i] = new ArrayList<>();
        }

        for (int i = 0; i < groups; i++) {
            groupGraph[i] = new ArrayList<>();
        }

        int[] itemIndegree = new int[n];
        int[] groupIndegree = new int[groups];

        // Build item and group dependency graphs
        for (int i = 0; i < n; i++) {
            for (int prev : beforeItems.get(i)) {
                itemGraph[prev].add(i);
                itemIndegree[i]++;

                if (group[prev] != group[i]) {
                    groupGraph[group[prev]].add(group[i]);
                    groupIndegree[group[i]]++;
                }
            }
        }

        List<Integer> itemOrder = topologicalSort(
            itemGraph, itemIndegree, n
        );

        List<Integer> groupOrder = topologicalSort(
            groupGraph, groupIndegree, groups
        );

        if (itemOrder.size() != n ||
            groupOrder.size() != groups) {
            return new int[0];
        }

        // Group items according to their assigned groups
        List<Integer>[] groupedItems = new ArrayList[groups];

        for (int i = 0; i < groups; i++) {
            groupedItems[i] = new ArrayList<>();
        }

        for (int item : itemOrder) {
            groupedItems[group[item]].add(item);
        }

        // Construct final grouped ordering
        int[] answer = new int[n];
        int index = 0;

        for (int g : groupOrder) {
            for (int item : groupedItems[g]) {
                answer[index++] = item;
            }
        }

        return answer;
    }

    private List<Integer> topologicalSort(
        List<Integer>[] graph,
        int[] indegree,
        int size
    ) {
        Queue<Integer> queue = new LinkedList<>();
        List<Integer> order = new ArrayList<>();

        for (int i = 0; i < size; i++) {
            if (indegree[i] == 0) {
                queue.offer(i);
            }
        }

        while (!queue.isEmpty()) {
            int node = queue.poll();
            order.add(node);

            for (int next : graph[node]) {
                indegree[next]--;

                if (indegree[next] == 0) {
                    queue.offer(next);
                }
            }
        }

        return order;
    }
}

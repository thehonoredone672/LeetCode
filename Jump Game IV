import java.util.*;

class Solution {
    public int minJumps(int[] arr) {
        int n = arr.length;

        if (n <= 1) {
            return 0;
        }

        // Map each value to all indices containing that value.
        Map<Integer, List<Integer>> indices = new HashMap<>();

        for (int i = 0; i < n; i++) {
            indices.computeIfAbsent(
                arr[i],
                key -> new ArrayList<>()
            ).add(i);
        }

        Queue<Integer> queue = new ArrayDeque<>();
        boolean[] visited = new boolean[n];

        queue.offer(0);
        visited[0] = true;

        int jumps = 0;

        while (!queue.isEmpty()) {
            int size = queue.size();

            for (int i = 0; i < size; i++) {
                int index = queue.poll();

                if (index == n - 1) {
                    return jumps;
                }

                // Jump to the previous index.
                if (index - 1 >= 0 && !visited[index - 1]) {
                    visited[index - 1] = true;
                    queue.offer(index - 1);
                }

                // Jump to the next index.
                if (index + 1 < n && !visited[index + 1]) {
                    visited[index + 1] = true;
                    queue.offer(index + 1);
                }

                // Jump to any index with the same value.
                int value = arr[index];
                List<Integer> sameValueIndices = indices.get(value);

                if (sameValueIndices != null) {
                    for (int next : sameValueIndices) {
                        if (!visited[next]) {
                            visited[next] = true;
                            queue.offer(next);
                        }
                    }

                    // Each value group needs to be processed only once.
                    indices.remove(value);
                }
            }

            jumps++;
        }

        return -1;
    }
}
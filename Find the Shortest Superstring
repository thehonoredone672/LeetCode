class Solution {
    public String shortestSuperstring(String[] words) {
        int n = words.length;
        int[][] overlap = new int[n][n];

        // Calculate maximum overlap between every pair
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (i == j) continue;

                int max = Math.min(
                    words[i].length(),
                    words[j].length()
                );

                for (int k = max; k >= 0; k--) {
                    if (words[i].endsWith(words[j].substring(0, k))) {
                        overlap[i][j] = k;
                        break;
                    }
                }
            }
        }

        int totalMasks = 1 << n;
        int[][] dp = new int[totalMasks][n];
        int[][] parent = new int[totalMasks][n];

        for (int[] row : dp) {
            java.util.Arrays.fill(row, Integer.MAX_VALUE / 2);
        }

        for (int[] row : parent) {
            java.util.Arrays.fill(row, -1);
        }

        for (int i = 0; i < n; i++) {
            dp[1 << i][i] = words[i].length();
        }

        // Bitmask DP
        for (int mask = 1; mask < totalMasks; mask++) {
            for (int last = 0; last < n; last++) {
                if ((mask & (1 << last)) == 0) continue;
                if (dp[mask][last] >= Integer.MAX_VALUE / 2) continue;

                for (int next = 0; next < n; next++) {
                    if ((mask & (1 << next)) != 0) continue;

                    int newMask = mask | (1 << next);

                    int cost = dp[mask][last]
                            + words[next].length()
                            - overlap[last][next];

                    if (cost < dp[newMask][next]) {
                        dp[newMask][next] = cost;
                        parent[newMask][next] = last;
                    }
                }
            }
        }

        // Find the best ending word
        int fullMask = totalMasks - 1;
        int last = 0;

        for (int i = 1; i < n; i++) {
            if (dp[fullMask][i] < dp[fullMask][last]) {
                last = i;
            }
        }

        // Reconstruct the word order
        java.util.List<Integer> order = new java.util.ArrayList<>();
        int mask = fullMask;

        while (last != -1) {
            order.add(last);

            int previous = parent[mask][last];
            mask ^= (1 << last);
            last = previous;
        }

        java.util.Collections.reverse(order);

        // Build the shortest superstring
        StringBuilder result = new StringBuilder();

        int first = order.get(0);
        result.append(words[first]);

        for (int i = 1; i < order.size(); i++) {
            int previous = order.get(i - 1);
            int current = order.get(i);

            result.append(
                words[current].substring(overlap[previous][current])
            );
        }

        return result.toString();
    }
}

import java.util.*;

class Solution {

    private String s;
    private Set<String> wordSet;
    private Map<Integer, List<String>> memo;

    public List<String> wordBreak(
            String s,
            List<String> wordDict) {

        this.s = s;
        this.wordSet = new HashSet<>(wordDict);
        this.memo = new HashMap<>();

        return dfs(0);
    }

    private List<String> dfs(int start) {

        // Already calculated
        if (memo.containsKey(start)) {
            return memo.get(start);
        }

        List<String> result = new ArrayList<>();

        // Entire string has been consumed
        if (start == s.length()) {
            result.add("");
            return result;
        }

        // Try every possible next word
        for (int end = start + 1;
             end <= s.length();
             end++) {

            String word = s.substring(start, end);

            if (!wordSet.contains(word)) {
                continue;
            }

            // Solve the remaining suffix
            List<String> suffixes = dfs(end);

            for (String suffix : suffixes) {

                if (suffix.isEmpty()) {
                    result.add(word);
                } else {
                    result.add(word + " " + suffix);
                }
            }
        }

        memo.put(start, result);

        return result;
    }
}
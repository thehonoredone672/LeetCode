import java.util.*;

class Solution {
    public int minAbsDifference(int[] nums, int goal) {
        int n = nums.length;
        int mid = n / 2;

        List<Integer> left = new ArrayList<>();
        List<Integer> right = new ArrayList<>();

        generateSums(nums, 0, mid, 0, left);
        generateSums(nums, mid, n, 0, right);

        Collections.sort(right);

        int answer = Math.abs(goal);

        for (int sum : left) {
            int target = goal - sum;

            int index = Collections.binarySearch(right, target);

            if (index >= 0) {
                return 0;
            }

            index = -index - 1;

            if (index < right.size()) {
                answer = Math.min(
                    answer,
                    Math.abs(sum + right.get(index) - goal)
                );
            }

            if (index > 0) {
                answer = Math.min(
                    answer,
                    Math.abs(sum + right.get(index - 1) - goal)
                );
            }
        }

        return answer;
    }

    private void generateSums(
        int[] nums,
        int start,
        int end,
        int sum,
        List<Integer> sums
    ) {
        if (start == end) {
            sums.add(sum);
            return;
        }

        generateSums(nums, start + 1, end, sum, sums);

        generateSums(
            nums, start + 1, end,
            sum + nums[start], sums
        );
    }
}

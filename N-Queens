import java.util.*;

class Solution {

    private List<List<String>> result;

    private char[][] board;

    private boolean[] columns;
    private boolean[] diagonal1;
    private boolean[] diagonal2;

    private int n;

    public List<List<String>> solveNQueens(int n) {

        this.n = n;

        result = new ArrayList<>();

        board = new char[n][n];

        // Initially all cells are empty
        for (int row = 0; row < n; row++) {
            Arrays.fill(board[row], '.');
        }

        // Track occupied columns
        columns = new boolean[n];

        // Track row - col diagonals
        diagonal1 = new boolean[2 * n - 1];

        // Track row + col diagonals
        diagonal2 = new boolean[2 * n - 1];

        backtrack(0);

        return result;
    }

    private void backtrack(int row) {

        // All queens have been placed
        if (row == n) {
            addSolution();
            return;
        }

        // Try every column
        for (int col = 0; col < n; col++) {

            int diag1 = row - col + n - 1;
            int diag2 = row + col;

            // Check whether this position is safe
            if (columns[col] ||
                diagonal1[diag1] ||
                diagonal2[diag2]) {
                continue;
            }

            // Place queen
            board[row][col] = 'Q';

            columns[col] = true;
            diagonal1[diag1] = true;
            diagonal2[diag2] = true;

            // Move to next row
            backtrack(row + 1);

            // Undo
            board[row][col] = '.';

            columns[col] = false;
            diagonal1[diag1] = false;
            diagonal2[diag2] = false;
        }
    }

    private void addSolution() {

        List<String> solution = new ArrayList<>();

        for (int row = 0; row < n; row++) {
            solution.add(new String(board[row]));
        }

        result.add(solution);
    }
}